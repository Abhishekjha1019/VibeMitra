digraph L1b {
  graph [rankdir=LR, splines=true, nodesep=0.3, ranksep=1.2, pad=0.3, fontname="Helvetica", labelloc=t, fontsize=20, label="Level 1 DFD (b): messaging, safety, subscriptions, notifications and privacy\n(solid = data flow; dashed = audit events)"];
  node [fontname="Helvetica", fontsize=14];
  edge [fontname="Helvetica", fontsize=12, color="#404040", arrowsize=0.7];
  member [label="Member", shape=box, style=filled, fillcolor="#F2F2F2"];
  admin [label="Admin /\nModerator", shape=box, style=filled, fillcolor="#F2F2F2"];
  gp [label="Google Play\nBilling", shape=box, style=filled, fillcolor="#F2F2F2"];
  pg [label="Payment\ngateways", shape=box, style=filled, fillcolor="#F2F2F2"];
  fcm [label="Firebase Cloud\nMessaging", shape=box, style=filled, fillcolor="#F2F2F2"];
  p5 [label="5.0\nMessaging", shape=ellipse, style=filled, fillcolor="#DEEAF6"];
  p6 [label="6.0\nSafety &\nmoderation", shape=ellipse, style=filled, fillcolor="#DEEAF6"];
  p7 [label="7.0\nSubscriptions\n& payments", shape=ellipse, style=filled, fillcolor="#DEEAF6"];
  p8 [label="8.0\nNotifications", shape=ellipse, style=filled, fillcolor="#DEEAF6"];
  p9 [label="9.0\nPrivacy, deletion\n& audit", shape=ellipse, style=filled, fillcolor="#DEEAF6"];
  d1 [label="D1 Identity &\naccount", shape=box, style=filled, fillcolor="#FFF2CC"];
  d2 [label="D2 Profiles &\npreferences", shape=box, style=filled, fillcolor="#FFF2CC"];
  d3 [label="D3 Matches &\nscores", shape=box, style=filled, fillcolor="#FFF2CC"];
  d4 [label="D4 Messages", shape=box, style=filled, fillcolor="#FFF2CC"];
  d5 [label="D5 Reports &\nmoderation", shape=box, style=filled, fillcolor="#FFF2CC"];
  d6 [label="D6 Subscriptions\n& payments", shape=box, style=filled, fillcolor="#FFF2CC"];
  d7 [label="D7 Notifications\n& device tokens", shape=box, style=filled, fillcolor="#FFF2CC"];
  d8 [label="D8 Audit & AI\nrequest logs", shape=box, style=filled, fillcolor="#FFF2CC"];
  member -> p5 [dir=both, label="messages"];
  p5 -> d4 [dir=both, label="encrypted messages"];
  p5 -> p6 [label="reported content"];
  member -> p6 [label="block, report"];
  admin -> p6 [label="moderation decisions"];
  p6 -> d5 [dir=both, label="reports, actions"];
  p6 -> d3 [label="blocks end matches"];
  p6 -> d1 [label="suspension status"];
  member -> p7 [dir=both, label="plan choice\n⇅ entitlement status"];
  p7 -> gp [dir=both, label="purchase token\n⇅ verified purchase"];
  p7 -> pg [dir=both, label="orders\n⇅ signed webhooks"];
  p7 -> d6 [dir=both, label="subscriptions, payments,\nentitlements"];
  p7 -> p8 [label="renewal and expiry events"];
  p8 -> d7 [dir=both, label="device tokens,\nnotifications"];
  p8 -> fcm [label="push requests"];
  member -> p9 [dir=both, label="deletion request,\nprivacy settings"];
  p9 -> d1 [label="anonymise / delete"];
  p9 -> d2 [label="purge profile data"];
  p9 -> d4 [label="purge messages"];
  p6 -> d8 [style=dashed];
  p7 -> d8 [style=dashed];
  p9 -> d8 [style=dashed];
}
