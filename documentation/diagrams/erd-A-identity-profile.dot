digraph erd_A {
  graph [rankdir=LR, splines=true, nodesep=0.35, ranksep=1.0, pad=0.3, fontname="Helvetica", labelloc=t, fontsize=16, label="ERD A: Identity &amp; Profile\n(PK = primary key, UK = unique, FK = foreign key; crow's foot = many)"];
  node [shape=plaintext, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=8, color="#404040", arrowsize=0.7];
  cities [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#1F4E79" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>cities</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">smallint</FONT></TD></TR></TABLE>>];
  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#1F4E79" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="phone_lookup_hash"><FONT COLOR="#C00000"><B>UK</B></FONT> phone_lookup_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">char(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email"><FONT COLOR="#C00000"><B>UK</B></FONT> email</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">citext</FONT></TD></TR></TABLE>>];
  otp_verifications [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#1F4E79" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>otp_verifications</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR></TABLE>>];
  auth_sessions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#1F4E79" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>auth_sessions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="refresh_token_hash"><FONT COLOR="#C00000"><B>UK</B></FONT> refresh_token_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">char(64)</FONT></TD></TR></TABLE>>];
  consents [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#1F4E79" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>consents</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR></TABLE>>];
  age_verifications [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#1F4E79" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>age_verifications</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT COLOR="#C00000"><B>PK</B></FONT> <FONT COLOR="#2E75B6"><B>FK</B></FONT> user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR></TABLE>>];
  profiles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#1F4E79" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>profiles</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT COLOR="#C00000"><B>PK</B></FONT> <FONT COLOR="#2E75B6"><B>FK</B></FONT> user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="city_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> city_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">smallint</FONT></TD></TR></TABLE>>];
  profile_photos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#1F4E79" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>profile_photos</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR></TABLE>>];
  interests [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#1F4E79" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>interests</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code"><FONT COLOR="#C00000"><B>UK</B></FONT> code</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">varchar(40)</FONT></TD></TR></TABLE>>];
  user_interests [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#1F4E79" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>user_interests</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT COLOR="#C00000"><B>PK</B></FONT> <FONT COLOR="#2E75B6"><B>FK</B></FONT> user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="interest_id"><FONT COLOR="#C00000"><B>PK</B></FONT> <FONT COLOR="#2E75B6"><B>FK</B></FONT> interest_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">smallint</FONT></TD></TR></TABLE>>];
  discovery_categories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#1F4E79" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>discovery_categories</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code"><FONT COLOR="#C00000"><B>UK</B></FONT> code</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">varchar(40)</FONT></TD></TR></TABLE>>];
  user_categories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#1F4E79" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>user_categories</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT COLOR="#C00000"><B>PK</B></FONT> <FONT COLOR="#2E75B6"><B>FK</B></FONT> user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id"><FONT COLOR="#C00000"><B>PK</B></FONT> <FONT COLOR="#2E75B6"><B>FK</B></FONT> category_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">smallint</FONT></TD></TR></TABLE>>];
  match_preferences [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#1F4E79" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>match_preferences</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT COLOR="#C00000"><B>PK</B></FONT> <FONT COLOR="#2E75B6"><B>FK</B></FONT> user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR></TABLE>>];
  privacy_settings [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#1F4E79" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>privacy_settings</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT COLOR="#C00000"><B>PK</B></FONT> <FONT COLOR="#2E75B6"><B>FK</B></FONT> user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR></TABLE>>];
  users -> otp_verifications [dir=both, arrowtail=tee, arrowhead=crowodot];
  users -> auth_sessions [dir=both, arrowtail=tee, arrowhead=crow];
  users -> consents [dir=both, arrowtail=tee, arrowhead=crow];
  users -> age_verifications [dir=both, arrowtail=tee, arrowhead=tee];
  users -> profiles [dir=both, arrowtail=tee, arrowhead=tee];
  cities -> profiles [dir=both, arrowtail=tee, arrowhead=crow];
  users -> profile_photos [dir=both, arrowtail=tee, arrowhead=crow];
  users -> user_interests [dir=both, arrowtail=tee, arrowhead=tee];
  interests -> user_interests [dir=both, arrowtail=tee, arrowhead=tee];
  users -> user_categories [dir=both, arrowtail=tee, arrowhead=tee];
  discovery_categories -> user_categories [dir=both, arrowtail=tee, arrowhead=tee];
  users -> match_preferences [dir=both, arrowtail=tee, arrowhead=tee];
  users -> privacy_settings [dir=both, arrowtail=tee, arrowhead=tee];
}
