digraph erd_B1 {
  graph [rankdir=LR, splines=true, nodesep=0.35, ranksep=1.0, pad=0.3, fontname="Helvetica", labelloc=t, fontsize=16, label="ERD B1: Matching\n(PK = primary key, UK = unique, FK = foreign key; crow's foot = many)"];
  node [shape=plaintext, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=8, color="#404040", arrowsize=0.7];
  matching_rule_versions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#385723" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>matching_rule_versions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="version"><FONT COLOR="#C00000"><B>UK</B></FONT> version</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_by_user_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> created_by_user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR></TABLE>>];
  swipe_actions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#385723" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>swipe_actions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="actor_user_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> actor_user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="target_user_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> target_user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> category_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">smallint</FONT></TD></TR></TABLE>>];
  compatibility_scores [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#385723" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>compatibility_scores</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="candidate_user_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> candidate_user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> category_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rule_version_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> rule_version_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">smallint</FONT></TD></TR></TABLE>>];
  matches [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#385723" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>matches</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_a_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> user_a_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_b_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> user_b_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> category_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">smallint</FONT></TD></TR></TABLE>>];
  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#D9D9D9" COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10"><B>users</B></FONT><FONT POINT-SIZE="8"> (see another figure)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR></TABLE>>];
  discovery_categories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#D9D9D9" COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10"><B>discovery_categories</B></FONT><FONT POINT-SIZE="8"> (see another figure)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">smallint</FONT></TD></TR></TABLE>>];
  users -> matching_rule_versions [dir=both, arrowtail=tee, arrowhead=crowodot];
  users -> swipe_actions [dir=both, arrowtail=tee, arrowhead=crow];
  users -> swipe_actions [dir=both, arrowtail=tee, arrowhead=crow];
  discovery_categories -> swipe_actions [dir=both, arrowtail=tee, arrowhead=crow];
  users -> compatibility_scores [dir=both, arrowtail=tee, arrowhead=crow];
  users -> compatibility_scores [dir=both, arrowtail=tee, arrowhead=crow];
  discovery_categories -> compatibility_scores [dir=both, arrowtail=tee, arrowhead=crow];
  matching_rule_versions -> compatibility_scores [dir=both, arrowtail=tee, arrowhead=crow];
  users -> matches [dir=both, arrowtail=tee, arrowhead=crow];
  users -> matches [dir=both, arrowtail=tee, arrowhead=crow];
  discovery_categories -> matches [dir=both, arrowtail=tee, arrowhead=crow];
}
