digraph erd_B2 {
  graph [rankdir=LR, splines=true, nodesep=0.35, ranksep=1.0, pad=0.3, fontname="Helvetica", labelloc=t, fontsize=16, label="ERD B2: Messaging &amp; Safety\n(PK = primary key, UK = unique, FK = foreign key; crow's foot = many)"];
  node [shape=plaintext, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=8, color="#404040", arrowsize=0.7];
  conversations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#385723" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>conversations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="match_id"><FONT COLOR="#C00000"><B>UK</B></FONT> <FONT COLOR="#2E75B6"><B>FK</B></FONT> match_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR></TABLE>>];
  messages [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#385723" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>messages</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="conversation_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> conversation_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sender_user_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> sender_user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR></TABLE>>];
  blocks [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#385723" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>blocks</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="blocker_user_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> blocker_user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="blocked_user_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> blocked_user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR></TABLE>>];
  reports [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#385723" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>reports</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="reporter_user_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> reporter_user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="reported_user_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> reported_user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="reported_message_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> reported_message_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR></TABLE>>];
  moderation_actions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#385723" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>moderation_actions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="report_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> report_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="target_user_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> target_user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="performed_by_user_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> performed_by_user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR></TABLE>>];
  matches [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#D9D9D9" COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10"><B>matches</B></FONT><FONT POINT-SIZE="8"> (see another figure)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR></TABLE>>];
  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#D9D9D9" COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10"><B>users</B></FONT><FONT POINT-SIZE="8"> (see another figure)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR></TABLE>>];
  matches -> conversations [dir=both, arrowtail=tee, arrowhead=tee];
  conversations -> messages [dir=both, arrowtail=tee, arrowhead=crow];
  users -> messages [dir=both, arrowtail=tee, arrowhead=crow];
  users -> blocks [dir=both, arrowtail=tee, arrowhead=crow];
  users -> blocks [dir=both, arrowtail=tee, arrowhead=crow];
  users -> reports [dir=both, arrowtail=tee, arrowhead=crow];
  users -> reports [dir=both, arrowtail=tee, arrowhead=crow];
  messages -> reports [dir=both, arrowtail=tee, arrowhead=crowodot];
  reports -> moderation_actions [dir=both, arrowtail=tee, arrowhead=crowodot];
  users -> moderation_actions [dir=both, arrowtail=tee, arrowhead=crow];
  users -> moderation_actions [dir=both, arrowtail=tee, arrowhead=crowodot];
}
