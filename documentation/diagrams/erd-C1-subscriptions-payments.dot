digraph erd_C1 {
  graph [rankdir=LR, splines=true, nodesep=0.35, ranksep=1.0, pad=0.3, fontname="Helvetica", labelloc=t, fontsize=16, label="ERD C1: Subscriptions &amp; Payments\n(PK = primary key, UK = unique, FK = foreign key; crow's foot = many)"];
  node [shape=plaintext, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=8, color="#404040", arrowsize=0.7];
  subscription_plans [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#7F6000" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>subscription_plans</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code"><FONT COLOR="#C00000"><B>UK</B></FONT> code</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="google_play_product_id"><FONT COLOR="#C00000"><B>UK</B></FONT> google_play_product_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">varchar(100)</FONT></TD></TR></TABLE>>];
  plan_features [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#7F6000" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>plan_features</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="plan_id"><FONT COLOR="#C00000"><B>PK</B></FONT> <FONT COLOR="#2E75B6"><B>FK</B></FONT> plan_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="feature_key"><FONT COLOR="#C00000"><B>PK</B></FONT> feature_key</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">varchar(60)</FONT></TD></TR></TABLE>>];
  subscriptions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#7F6000" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>subscriptions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="plan_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> plan_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="provider_subscription_id"><FONT COLOR="#C00000"><B>UK</B></FONT> provider_subscription_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">varchar(128)</FONT></TD></TR></TABLE>>];
  entitlements [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#7F6000" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>entitlements</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="source_subscription_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> source_subscription_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR></TABLE>>];
  payment_transactions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#7F6000" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>payment_transactions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="subscription_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> subscription_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="provider_payment_id"><FONT COLOR="#C00000"><B>UK</B></FONT> provider_payment_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">varchar(128)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="idempotency_key"><FONT COLOR="#C00000"><B>UK</B></FONT> idempotency_key</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">varchar(100)</FONT></TD></TR></TABLE>>];
  refunds [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#7F6000" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>refunds</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="transaction_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> transaction_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="provider_refund_id"><FONT COLOR="#C00000"><B>UK</B></FONT> provider_refund_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">varchar(128)</FONT></TD></TR></TABLE>>];
  payment_webhook_events [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#7F6000" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>payment_webhook_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR></TABLE>>];
  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#D9D9D9" COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10"><B>users</B></FONT><FONT POINT-SIZE="8"> (see another figure)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR></TABLE>>];
  subscription_plans -> plan_features [dir=both, arrowtail=tee, arrowhead=tee];
  users -> subscriptions [dir=both, arrowtail=tee, arrowhead=crow];
  subscription_plans -> subscriptions [dir=both, arrowtail=tee, arrowhead=crow];
  users -> entitlements [dir=both, arrowtail=tee, arrowhead=crow];
  subscriptions -> entitlements [dir=both, arrowtail=tee, arrowhead=crowodot];
  users -> payment_transactions [dir=both, arrowtail=tee, arrowhead=crow];
  subscriptions -> payment_transactions [dir=both, arrowtail=tee, arrowhead=crowodot];
  payment_transactions -> refunds [dir=both, arrowtail=tee, arrowhead=crow];
}
