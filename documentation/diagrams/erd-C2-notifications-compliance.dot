digraph erd_C2 {
  graph [rankdir=LR, splines=true, nodesep=0.35, ranksep=1.0, pad=0.3, fontname="Helvetica", labelloc=t, fontsize=16, label="ERD C2: Notifications &amp; Compliance\n(PK = primary key, UK = unique, FK = foreign key; crow's foot = many)"];
  node [shape=plaintext, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=8, color="#404040", arrowsize=0.7];
  device_tokens [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#7F6000" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>device_tokens</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fcm_token"><FONT COLOR="#C00000"><B>UK</B></FONT> fcm_token</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">varchar(512)</FONT></TD></TR></TABLE>>];
  notification_settings [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#7F6000" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>notification_settings</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT COLOR="#C00000"><B>PK</B></FONT> <FONT COLOR="#2E75B6"><B>FK</B></FONT> user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="notification_type"><FONT COLOR="#C00000"><B>PK</B></FONT> notification_type</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">enum</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="channel"><FONT COLOR="#C00000"><B>PK</B></FONT> channel</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">enum</FONT></TD></TR></TABLE>>];
  notifications [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#7F6000" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>notifications</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR></TABLE>>];
  account_deletion_requests [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#7F6000" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>account_deletion_requests</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR></TABLE>>];
  audit_logs [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#7F6000" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>audit_logs</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="actor_user_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> actor_user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR></TABLE>>];
  ai_request_logs [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#7F6000" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>ai_request_logs</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT COLOR="#2E75B6"><B>FK</B></FONT> user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR></TABLE>>];
  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD BGCOLOR="#D9D9D9" COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10"><B>users</B></FONT><FONT POINT-SIZE="8"> (see another figure)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#C00000"><B>PK</B></FONT> id</TD><TD ALIGN="LEFT"><FONT COLOR="#595959" POINT-SIZE="8">uuid</FONT></TD></TR></TABLE>>];
  users -> device_tokens [dir=both, arrowtail=tee, arrowhead=crow];
  users -> notification_settings [dir=both, arrowtail=tee, arrowhead=tee];
  users -> notifications [dir=both, arrowtail=tee, arrowhead=crow];
  users -> account_deletion_requests [dir=both, arrowtail=tee, arrowhead=crow];
  users -> audit_logs [dir=both, arrowtail=tee, arrowhead=crowodot];
  users -> ai_request_logs [dir=both, arrowtail=tee, arrowhead=crowodot];
}
